---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import FeaturedHero from "@/components/FeaturedHero.astro";
import NewsCard from "@/components/NewsCard.astro";
import Pagination from "@/components/Pagination.astro";
import { getMainSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const sortedPosts = getMainSortedPosts(posts);
  return paginate(sortedPosts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

const heroPost = page.data[0];
const gridPosts = page.data.slice(1);

const homePath = getRelativeLocaleUrl(locale, "");
const rssUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
const archivePath = getRelativeLocaleUrl(locale, "posts");
const isFirstPage = page.currentPage === 1;
---

<Layout
  title={
    isFirstPage ? undefined : `Página ${page.currentPage} · ${config.site.title}`
  }
>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-4"
  >
    <h1 class="sr-only">Ping Diario</h1>

    <section class="border-border border-b pt-6 pb-5">
      <p class="max-w-2xl text-muted-foreground">
        El pulso diario del mundo Cloud Native: un resumen ágil y curado con lo
        más relevante en{' '}
        <strong class="text-foreground">
          Kubernetes, Cloud, Observabilidad y Seguridad
        </strong>.
        <a
          target="_blank"
          href={rssUrl}
          class="ms-2 inline-flex align-middle text-accent"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={18} height={18} class="stroke-accent stroke-3" />
        </a>
      </p>
    </section>

    {
      heroPost && (
        <section class="pt-8">
          <FeaturedHero post={heroPost} />
        </section>
      )
    }

    {
      gridPosts.length > 0 && (
        <section class="pt-10">
          <div class="flex items-baseline justify-between">
            <h2 class="text-xl font-semibold tracking-tight">
              {isFirstPage ? "Últimas noticias" : "Más noticias"}
            </h2>
            {
              isFirstPage && (
                <a
                  href={archivePath}
                  class="text-sm text-accent hover:underline"
                >
                  Ver archivo completo →
                </a>
              )
            }
          </div>
          <ul
            class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
          >
            {gridPosts.map(post => (
              <NewsCard post={post} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="pt-12">
      <Pagination page={page} base="" />
    </div>
  </main>
  <Footer noMarginTop={page.lastPage > 1} />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
