---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostCover } from "@/utils/postCover";
import Datetime from "./Datetime.astro";

type Props = { post: CollectionEntry<"posts"> };

const { post } = Astro.props;
const { data } = post;
const cover = getPostCover(post);
const tag = data.tags?.[0] ?? "ia";
const postUrl = getPostUrl(post.id, post.filePath, Astro.currentLocale);

const coverGradients: Record<string, string> = {
  kubernetes: "from-[#0c4a6e] via-[#2563eb] to-[#7dd3fc]",
  cloud: "from-[#0c4a6e] via-[#0284c7] to-[#38bdf8]",
  seguridad: "from-[#7f1d1d] via-[#dc2626] to-[#f97316]",
  observabilidad: "from-[#78350f] via-[#d97706] to-[#facc15]",
  ia: "from-[#4c1d95] via-[#7c3aed] to-[#0ea5e9]",
  devops: "from-[#14532d] via-[#16a34a] to-[#4ade80]",
  infraestructura: "from-[#1e293b] via-[#475569] to-[#94a3b8]",
  arquitectura: "from-[#134e4a] via-[#0d9488] to-[#5eead4]",
};
---

<section class="featured-hero">
  <div class="featured-hero__copy min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span
        class="bg-accent text-accent-foreground rounded-full px-2.5 py-0.5 text-[11px] font-bold tracking-wider uppercase"
      >
        Destacado
      </span>
      <span
        class="border-border text-muted-foreground rounded-full border px-2.5 py-0.5 text-[11px] font-semibold tracking-wider uppercase"
      >
        {tag}
      </span>
    </div>
    <h2
      class="mt-4 max-w-2xl text-3xl leading-[1.04] font-bold tracking-tight sm:text-4xl lg:text-6xl"
    >
      <a href={postUrl} class="hover:text-accent transition-colors">
        {data.title}
      </a>
    </h2>
    <p
      class="text-muted-foreground mt-5 line-clamp-3 max-w-xl text-base sm:text-lg"
    >
      {data.description}
    </p>
    <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-3">
      <Datetime {...data} />
      <a
        href={postUrl}
        class="bg-accent text-accent-foreground min-h-11 rounded-full px-5 py-2 text-sm font-semibold transition-opacity hover:opacity-85"
      >
        Leer noticia →
      </a>
    </div>
  </div>
  <a
    href={postUrl}
    class="featured-hero__media relative aspect-[16/10] min-w-0 overflow-hidden rounded-2xl"
  >
    {
      cover ? (
        <img
          src={cover}
          alt={`Portada: ${data.title}`}
          loading="eager"
          decoding="async"
          class="absolute inset-0 size-full object-cover"
        />
      ) : (
        <div
          class:list={[
            "absolute inset-0 flex items-center justify-center bg-linear-to-br",
            coverGradients[tag] ?? coverGradients["ia"],
          ]}
        >
          <span class="text-5xl font-bold tracking-widest text-white/60 uppercase">
            {tag}
          </span>
        </div>
      )
    }
  </a>
</section>
