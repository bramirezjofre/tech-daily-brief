---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostCover } from "@/utils/postCover";
import Datetime from "./Datetime.astro";

type Props = { post: CollectionEntry<"posts"> };

const { post } = Astro.props;
const { data } = post;
const cover = getPostCover(post);
const tag = data.tags?.[0] ?? "ia";

const chipColors: Record<string, string> = {
  kubernetes:
    "text-sky-700 border-sky-700/30 dark:text-sky-300 dark:border-sky-400/40",
  cloud: "text-blue-700 border-blue-700/30 dark:text-blue-300 dark:border-blue-400/40",
  seguridad:
    "text-rose-700 border-rose-700/30 dark:text-rose-300 dark:border-rose-400/40",
  observabilidad:
    "text-amber-700 border-amber-700/30 dark:text-amber-300 dark:border-amber-400/40",
  ia: "text-violet-700 border-violet-700/30 dark:text-violet-300 dark:border-violet-400/40",
  devops:
    "text-emerald-700 border-emerald-700/30 dark:text-emerald-300 dark:border-emerald-400/40",
  infraestructura:
    "text-slate-600 border-slate-600/30 dark:text-slate-300 dark:border-slate-400/40",
  arquitectura:
    "text-teal-700 border-teal-700/30 dark:text-teal-300 dark:border-teal-400/40",
};

const coverGradients: Record<string, string> = {
  kubernetes: "from-[#0c4a6e] via-[#2563eb] to-[#7dd3fc]",
  cloud: "from-[#0c4a6e] via-[#0284c7] to-[#38bdf8]",
  seguridad: "from-[#7f1d1d] via-[#dc2626] to-[#f97316]",
  observabilidad: "from-[#78350f] via-[#d97706] to-[#facc15]",
  ia: "from-[#4c1d95] via-[#7c3aed] to-[#0ea5e9]",
  devops: "from-[#14532d] via-[#16a34a] to-[#4ade80]",
  infraestructura: "from-[#1e293b] via-[#475569] to-[#94a3b8]",
  arquitectura: "from-[#134e4a] via-[#0d9488] to-[#5eead4]",
};
---

<li class="min-w-0">
  <a
    href={getPostUrl(post.id, post.filePath, Astro.currentLocale)}
    class="news-card group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-muted/40 transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-lg"
  >
    <div class="relative aspect-video overflow-hidden">
      {
        cover ? (
          <img
            src={cover}
            alt={`Portada: ${data.title}`}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        ) : (
          <div
            class:list={[
              "absolute inset-0 flex items-center justify-center bg-linear-to-br",
              coverGradients[tag] ?? coverGradients["ia"],
            ]}
          >
            <span class="text-3xl font-bold tracking-widest text-white/60 uppercase">
              {tag}
            </span>
          </div>
        )
      }
    </div>
    <div class="flex flex-1 flex-col gap-2 p-5">
      <span
        class:list={[
          "self-start rounded-full border px-2 py-0.5 text-[11px] font-semibold tracking-wider uppercase",
          chipColors[tag] ?? chipColors["ia"],
        ]}
      >
        {tag}
      </span>
      <h3 class="line-clamp-2 text-base leading-snug font-semibold transition-colors group-hover:text-accent">
        {data.title}
      </h3>
      <p class="line-clamp-2 text-sm text-muted-foreground">
        {data.description}
      </p>
      <div class="mt-auto flex items-center justify-between pt-2">
        <Datetime {...data} />
        <span class="inline-flex min-h-11 items-center text-xs font-semibold text-accent">Leer →</span>
      </div>
    </div>
  </a>
</li>
